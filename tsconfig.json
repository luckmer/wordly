{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    "ignoreDeprecations": "6.0",
    "baseUrl": ".",

    "paths": {
      "@components/*": ["./src/components/*"],
      "@containers/*": ["./src/containers/*"],
      "@interfaces/*": ["./src/interfaces/*"],
      "@pages/*": ["./src/pages/*"],
      "@store/*": ["./src/store/*"],
      "@common/*": ["./src/common/*"],
      "@static/*": ["./src/static/*"],
      "@utils/*": ["./src/utils/*"],
      "@libs/*": ["./src/libs/*"],
      "@json/*": ["./src/json/*"],
      "@routes/*": ["./src/routes/*"]
    }
  }
}
